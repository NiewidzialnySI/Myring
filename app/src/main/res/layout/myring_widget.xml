<?xml version="1.0" encoding="utf-8"?>
<!-- Layout startowy / podgląd (Glance renderuje właściwy UI). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_ring_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/widget_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="@color/widget_primary"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/widget_days_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="do wyjęcia"
            android:textSize="13sp"
            android:textColor="@color/widget_on_surface_variant"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="22.10.2026"
            android:textSize="12sp"
            android:textColor="@color/widget_on_surface_variant"
            android:fontFamily="sans-serif" />
    </LinearLayout>
</FrameLayout>
