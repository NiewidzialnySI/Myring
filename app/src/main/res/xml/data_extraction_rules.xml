<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: wyklucz prefs cyklu/zapasu/alarmów (jak backup_rules.xml). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="myring_settings.xml"/>
        <exclude domain="sharedpref" path="myring_stock.xml"/>
        <exclude domain="sharedpref" path="myring_reminders.xml"/>
        <exclude domain="sharedpref" path="myring_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="myring_settings.xml"/>
        <exclude domain="sharedpref" path="myring_stock.xml"/>
        <exclude domain="sharedpref" path="myring_reminders.xml"/>
        <exclude domain="sharedpref" path="myring_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
